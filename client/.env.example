# Local development: the API runs separately on port 3001 (see server/.env.example)
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# Production (Docker image): leave both unset — the client is served by the API server
# on the same origin, so API calls go to /api and Socket.IO to the page origin.
