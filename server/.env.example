# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning
DB_USER=learning
DB_PASSWORD=your_database_password
# DB_SSL=true            # only if the server requires TLS

# --- Auth ---
# Generate with: openssl rand -base64 48   (must be >= 32 chars; the server refuses to start otherwise)
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# Optional: the first account registered with this email becomes admin + approved automatically
BOOTSTRAP_ADMIN_EMAIL=

# --- Email (Nodemailer / Gmail app password) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# --- Passwords ---
# REQUIRED in production. Encrypts every stored password hash, so a copy of the database alone
# cannot be cracked. Generate once: openssl rand -base64 32
# Keep it ONLY here / in Dokploy's Environment tab, never in the database or its backups, and
# keep a copy in your password manager: if it is lost, nobody can log in until passwords are reset.
PASSWORD_PEPPER=
# Local dev without SMTP: print login codes to the console (never honoured in production)
# LOG_LOGIN_CODES=true
# Rotation: move the old key here (comma-separated) and set a new PASSWORD_PEPPER; every hash is
# re-encrypted at the next start, then the old key can be removed.
# PASSWORD_PEPPER_PREVIOUS=
# New passwords are checked against Have I Been Pwned (only a 5-char hash prefix is sent).
# PASSWORD_BREACH_CHECK=false
# Login / code / register attempts per IP per 15 minutes (default 20)
# AUTH_RATE_LIMIT=20

# --- Server ---
PORT=3001
NODE_ENV=development
# Public URL of the app (used in emails; also the allowed CORS origin when the client is served elsewhere)
FRONTEND_URL=http://localhost:5173
# Where uploaded files are stored (a persistent volume in production)
# UPLOADS_DIR=/app/server/uploads
# Upload size limits in MB (task submissions / images)
# MAX_UPLOAD_MB=25
# MAX_IMAGE_UPLOAD_MB=10
